# Every value is validated at startup; an invalid one stops the app with a clear error.

# local | test | production  (exact; production requires both META_* values below)
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON list of exact browser origins: scheme://host[:port], no path, no trailing slash
CORS_ORIGINS=["http://localhost:5173"]

# Matches docker-compose.yml. postgres:// and postgresql:// URLs are also accepted.
DATABASE_URL=postgresql+psycopg://lead_intake:lead_intake@localhost:5432/lead_intake
# Used only by pytest (created by backend/scripts/init-test-db.sql).
TEST_DATABASE_URL=postgresql+psycopg://lead_intake:lead_intake@localhost:5432/lead_intake_test

# Meta webhook: app secret signs X-Hub-Signature-256; verify token is for the GET handshake.
META_APP_SECRET=change-me
META_VERIFY_TOKEN=change-me
