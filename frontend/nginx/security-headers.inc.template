# Included in every location: an add_header inside a location drops all inherited ones, so the
# security headers cannot live at server level alongside per-location Cache-Control headers.
# (Named .inc, not .conf, so nginx does not also load it at http level from conf.d/*.conf.)

add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "DENY" always;
# The app loads only its own scripts, styles and images, and talks only to itself and the API.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
